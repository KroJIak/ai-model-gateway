# === Мост (этот API-ключ вставляется в Open WebUI) ===
BRIDGE_API_KEY=sk-bridge-...

# === Провайдер (любой OpenAI-совместимый релей) — данные для обоих сервисов ===
GROK_BASE_URL=https://your-relay.example/v1
GROK_API_KEY=sk-...
GROK_DEFAULT_MODEL=grok-4.6
GROK_API_TIMEOUT=240
GROK_MODELS_TTL=60

# CLIProxyAPI (gpt-api): входящий ключ + релей
GPT_API_KEYS=sk-gpt-api-internal-key
GPT_PROVIDER_BASE_URL=https://your-relay.example/v1
GPT_PROVIDER_API_KEY=sk-...
