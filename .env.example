BRIDGE_API_KEY=sk-bridge-...

GROK_BASE_URL=https://your-relay.example/v1
GROK_API_KEY=sk-...

GPT_PROVIDER_BASE_URL=https://your-relay.example/v1
GPT_PROVIDER_API_KEY=sk-...

# Опционально: внутренний ключ между мостом и gpt-api (должен совпадать с обеих сторон)
#GPT_API_KEYS=sk-internal-gpt-api-key
# Опционально: адрес gpt-api внутри docker-сети
#GPT_API_BASE_URL=http://gpt-api:8317

# Опционально: тайминги, секунды
#BRIDGE_CACHE_TTL=30
#BRIDGE_READ_TIMEOUT=600
#GROK_API_TIMEOUT=240
#TOOLS_RETRY_TTL_DAYS=7

# Опционально: внешние порты (нужны только для docker-compose.override.yml)
#BRIDGE_EXTERNAL_PORT=8081
#GPT_API_EXTERNAL_PORT=18317
#GROK_API_EXTERNAL_PORT=18090
